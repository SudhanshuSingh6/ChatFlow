# Copy to `.env` (gitignored) and fill in. docker-compose substitutes ${VAR} from here
# automatically. In production these MUST be overridden (the app fails fast under the `prod`
# profile if JWT_SECRET / INTERNAL_TOKEN are still the dev defaults).

# Shared HS256 secret used to mint (core) and verify (ai, gateway) JWTs. >= 32 chars.
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars

# Shared token guarding service-to-service /internal endpoints (core <-> ai).
INTERNAL_TOKEN=dev-internal-token

# HMAC secret for signing local /media/** URLs (only used under the non-s3 storage profile).
# Separate from JWT_SECRET — different trust domain. >= 32 chars.
MEDIA_SIGNING_SECRET=change-me-local-media-signing-secret-32-chars

# AI provider keys — leave blank to disable embeddings/RAG/summary.
AI_EMBEDDING_API_KEY=
ANTHROPIC_API_KEY=

# Datastore / object-store creds (compose defaults shown; override for real deployments).
# DB_USERNAME=chatflow
# DB_PASSWORD=chatflow
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
